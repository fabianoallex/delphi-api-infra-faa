<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="tests\Unit\Infra.UnitTests.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="tests\Integration\Infra.IntegrationTests.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="Infra_UnitTests">
        <MSBuild Projects="tests\Unit\Infra.UnitTests.dproj"/>
    </Target>
    <Target Name="Infra_UnitTests:Clean">
        <MSBuild Projects="tests\Unit\Infra.UnitTests.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Infra_UnitTests:Make">
        <MSBuild Projects="tests\Unit\Infra.UnitTests.dproj" Targets="Make"/>
    </Target>
    <Target Name="Infra_IntegrationTests">
        <MSBuild Projects="tests\Integration\Infra.IntegrationTests.dproj"/>
    </Target>
    <Target Name="Infra_IntegrationTests:Clean">
        <MSBuild Projects="tests\Integration\Infra.IntegrationTests.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Infra_IntegrationTests:Make">
        <MSBuild Projects="tests\Integration\Infra.IntegrationTests.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="Infra_UnitTests;Infra_IntegrationTests"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="Infra_UnitTests:Clean;Infra_IntegrationTests:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="Infra_UnitTests:Make;Infra_IntegrationTests:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
